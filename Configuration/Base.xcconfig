// Shared, non-secret build settings. Environment-specific values belong in
// Debug.xcconfig, Staging.xcconfig, or Production.xcconfig.

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

DOS_APP_ENVIRONMENT = unset
DOS_APP_DISPLAY_NAME = Day of Service
DOS_APP_BUNDLE_IDENTIFIER = org.dayofservice.app.unconfigured
DOS_API_SCHEME = https
DOS_API_HOST = unconfigured.invalid

