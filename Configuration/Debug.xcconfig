#include "Base.xcconfig"

DOS_APP_ENVIRONMENT = debug
DOS_APP_DISPLAY_NAME = Day of Service Dev
DOS_APP_BUNDLE_IDENTIFIER = org.dayofservice.app.debug
DOS_API_SCHEME = https
DOS_API_HOST = api-debug.dayofservice.invalid

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
ONLY_ACTIVE_ARCH = YES

