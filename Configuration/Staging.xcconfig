#include "Base.xcconfig"

DOS_APP_ENVIRONMENT = staging
DOS_APP_DISPLAY_NAME = Day of Service Staging
DOS_APP_BUNDLE_IDENTIFIER = org.dayofservice.app.staging
DOS_API_SCHEME = https
DOS_API_HOST = api-staging.dayofservice.invalid

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) STAGING
SWIFT_OPTIMIZATION_LEVEL = -O
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ONLY_ACTIVE_ARCH = NO

